          "status": 201,
          "body": {
            "id": "pay_1",
            "reference": "42-1",
            "amount": 5000,
            "currency": null,
            "commission": 100,
            "net_amount": 4900,
            "status": "pending",
            "checkout_url": "https://pay-api.technas.fr/checkout/pay_1",
            "metadata": {},
            "test_mode": true,
            "created_at": "2026-11-15T10:00:00Z",
            "expires_at": "2026-11-15T11:00:00Z"
