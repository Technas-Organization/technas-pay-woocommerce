        "path": "/payments",
        "body": {
          "orderId": "42"
        }
      },
      "user": "u1",
      "orders": {
        "42": {
          "amount": 5000,
          "customer": {
            "email": "awa@exemple.tg",
            "name": "Awa Mensah"
