<?xml version="1.0"?>
<ruleset name="Technas Pay WooCommerce">
  <description>WordPress-Extra et WordPress-VIP-Go : toutes les règles de SÉCURITÉ actives (échappement, assainissement, nonces, SQL, accès direct). Le style WordPress est appliqué (tabulations, espaces). Seules sont écartées : les conditions Yoda, le nommage class-*.php déjà suivi, l'obligation de docblocks et le ternaire court.</description>
  <file>technas-pay-woocommerce.php</file>
  <file>includes</file>
  <arg name="extensions" value="php"/>
  <arg value="sp"/>
  <config name="minimum_wp_version" value="6.3"/>
  <config name="testVersion" value="8.1-"/>

  <rule ref="WordPress-Extra">
    <exclude name="Squiz.Commenting"/>
    <exclude name="Generic.Commenting"/>
    <exclude name="WordPress.PHP.YodaConditions"/>
    <exclude name="WordPress.Files.FileName"/>
    <exclude name="Universal.Operators.DisallowShortTernary"/>
    <exclude name="Generic.CodeAnalysis.UnusedFunctionParameter"/>
  </rule>
  <rule ref="WordPress-VIP-Go"/>
  <!-- Les propriétés en camelCase sont celles de l'API du SDK technas/pay ($payment->checkoutUrl…). -->
  <rule ref="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase">
    <severity>0</severity>
  </rule>
  <!-- Capacité définie par WooCommerce. -->
  <rule ref="WordPress.WP.Capabilities">
    <properties><property name="custom_capabilities" type="array"><element value="edit_shop_orders"/></property></properties>
  </rule>
  <rule ref="WordPress.WP.I18n">
    <properties><property name="text_domain" type="array"><element value="technas-pay-woocommerce"/></property></properties>
  </rule>
  <rule ref="WordPress.Security"/>
  <rule ref="WordPress.DB"/>
</ruleset>
